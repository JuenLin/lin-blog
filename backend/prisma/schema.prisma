// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// 第 5 批（已获用户批准）：用户角色与账号状态。
// 封闭值域由 DB 层（MySQL ENUM）强制，不走 category 式的 String + zod 白名单
// （理由见 docs/DB.md「第 5 批：role / status 两列」）。均 NOT NULL + 默认值，
// INSTANT 算法自动回填既有行。封禁拦截在应用层（登录接口 + auth 中间件双查），
// JWT payload 不放这两列——放了封禁后旧 token 不失效。
enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  nickname  String?   @db.VarChar(50)
  // 第九批（已获用户批准）：头像 URL 与简介。均 nullable，无需回填现有数据。
  // 头像走「零依赖 URL 版」——只存外链字符串，服务端不上传、不校验可达性，
  // 但 API 层校验必须以 http:// 或 https:// 开头，挡掉 javascript: / data:。
  avatar    String?   @db.VarChar(255)
  bio       String?   @db.VarChar(200)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  // 第 5 批（已获用户批准）：角色与账号状态。管理员赋值不走迁移文件，
  // 迁移后手动 UPDATE users SET role = 'ADMIN' WHERE username IN ('admin', 'lin')。
  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)
  articles  Article[]
  comments  Comment[]
  likes     Like[]
  revisions ArticleRevision[]
  // 第 4 批（已获用户批准）：关注关系。
  //   - following 走 "Follower" 关系：我是关注者 → 我关注的人列表
  //   - followers 走 "Following" 关系：我是被关注者 → 关注我的人列表
  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")

  @@map("users")
}

model Article {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(100)
  content   String    @db.MediumText
  // 2026-10-04（用户批准）：分类列。枚举白名单（技术/生活/随笔/未分类）由后端校验，
  // 不建 categories 表、不加外键。NOT NULL + 默认 '未分类'，INSTANT 算法自动回填既有行。
  category  String    @default("未分类") @db.VarChar(20)
  status    ArticleStatus @default(PUBLISHED)
  authorId  Int       @map("author_id")
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  comments  Comment[]
  likes     Like[]
  revisions ArticleRevision[]
  tags      ArticleTag[]

  @@index([deletedAt, createdAt])
  @@index([deletedAt, updatedAt])
  @@index([status, createdAt])
  @@map("articles")
}

model ArticleRevision {
  id        Int       @id @default(autoincrement())
  articleId Int       @map("article_id")
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(100)
  content   String    @db.MediumText
  category  String    @default("未分类") @db.VarChar(20)
  authorId  Int       @map("author_id")
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([articleId, createdAt])
  @@map("article_revisions")
}

model Comment {
  id        Int       @id @default(autoincrement())
  articleId Int       @map("article_id")
  article   Article   @relation(fields: [articleId], references: [id])
  authorId  Int       @map("author_id")
  author    User      @relation(fields: [authorId], references: [id])
  // 第 7 批（用户批准）：父评论自引用。NULL = 顶层评论；非空 = 对该评论的回复。
  // 两层硬限制（parentId 只允许指向顶层评论）由应用层校验，DB 层无法表达该约束。
  // onDelete: Cascade 兜底硬删场景；软删父评论的级联软删由应用层事务完成。
  parentId  Int?      @map("parent_id")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  content   String    @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([articleId, createdAt])
  @@index([parentId])
  @@map("comments")
}

// 第 7 批（用户批准）：标签多对多。tags.name 的 DB 唯一约束是「防重复标签」的
// 唯一真相（应用层 upsert 的竞态兜底，同 likes / follows 的唯一约束纪律）。
model Tag {
  id        Int          @id @default(autoincrement())
  name      String       @unique @db.VarChar(20)
  createdAt DateTime     @default(now()) @map("created_at")
  articles  ArticleTag[]

  @@map("tags")
}

// 中间表与 likes / follows 同构：无 deleted_at / updated_at（关联的存在即事实，
// 解除关联是物理 DELETE）。联合主键防重复关联；双 Cascade 外键兜底硬删清理
// （本项目删文章走软删，行不消失、关联保留，所有公开出口已过滤，无泄露）。
model ArticleTag {
  articleId Int      @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     Int      @map("tag_id")
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

// 第十批：文章点赞。
// 「点赞」是一个动作而不是一条可隐藏的内容，所以本表**刻意不设 deleted_at**
// （与 articles / comments 的软删除约定不同）：取消点赞是撤销动作，用物理 DELETE。
// 若改成软删，同一 (user_id, article_id) 取消后再赞会撞唯一约束，
// 只能变成 UPDATE 而非 INSERT，「点赞 = 该行存在」这个不变式就不再成立。
model Like {
  id        Int      @id @default(autoincrement())
  // 点赞者不是「作者」，按 docs/DB.md「外键命名规则」用 user_id 而非 author_id。
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  articleId Int      @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  // 防重复点赞的唯一约束。应用层「先查后写」存在竞态窗口（两个并发请求都查到
  // 「未赞」→ 都插入），**DB 唯一约束是唯一真相**，由它最终拦截并回 P2002。
  @@unique([userId, articleId], name: "likes_user_id_article_id_key")
  // 支撑「某篇文章的 likeCount」实时 count（走 SELECT COUNT(*) WHERE article_id = ?）
  // 与「我赞过哪些文章」。user_id 侧不另建索引：上面唯一索引的左前缀已承担。
  @@index([articleId])
  @@map("likes")
}

// 第 4 批（已获用户批准）：关注关系。
// 「关注」是关系状态而非可隐藏内容，故与 likes 同构——**刻意不设 deleted_at / updated_at**，
// 取消关注用物理 DELETE。「我关注的」(follower_id) 与「关注我的」(following_id) 角色不同，
// 用命名关系 Follower / Following 区分，避免 Prisma 自引用歧义。
model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int      @map("follower_id")
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  followingId Int      @map("following_id")
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  // 防重复关注：同一 (follower_id, following_id) 唯一。并发重复关注由 DB 唯一约束最终拦截
  // （报 1062 / P2002），应用层「先查后写」仅作友好提示，不作为正确性保障。
  @@unique([followerId, followingId], name: "follows_follower_id_following_id_key")
  // 支撑「某用户的粉丝数」实时 count（SELECT COUNT(*) WHERE following_id = ?）。
  // follower_id 侧不另建索引：上面唯一索引的左前缀已承担。
  @@index([followingId])
  @@map("follows")
}
